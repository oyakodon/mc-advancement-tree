{
  "name": "mc-advancement-tree",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write --ignore-path .gitignore './**/*.{js,jsx,ts,tsx,json}'",
    "test": "vitest",
    "pages:build": "bun x @cloudflare/next-on-pages",
    "deploy": "bun pages:build && wrangler pages deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv env.d.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "seed:up": "bun run ./scripts/seed.ts -c up",
    "seed:down": "bun run ./scripts/seed.ts -c down"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tailwindcss/postcss": "^4.0.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.7.4",
    "lucide-react": "^0.482.0",
    "next": "15.1.7",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.3",
    "react": "19.0.0",
    "react-d3-tree": "^3.6.6",
    "react-dom": "19.0.0",
    "react-select": "^5.10.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.14",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.10",
    "@cloudflare/workers-types": "^4.20250313.0",
    "@eslint/eslintrc": "^3.3.0",
    "@storybook/addon-essentials": "8.6.6",
    "@storybook/addon-interactions": "8.6.6",
    "@storybook/addon-themes": "^8.6.6",
    "@storybook/blocks": "8.6.6",
    "@storybook/nextjs": "8.6.6",
    "@storybook/react": "8.6.6",
    "@storybook/test": "8.6.6",
    "@types/bun": "^1.2.5",
    "@types/node": "^22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.2",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-storybook": "^0.11.4",
    "eslint-plugin-unused-imports": "^4.1.4",
    "prettier": "^3.5.3",
    "storybook": "8.6.6",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8",
    "wrangler": "^4.0.0"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
