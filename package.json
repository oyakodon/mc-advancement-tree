    "@tailwindcss/postcss": "^4.0.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.7.2",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "next-themes": "^0.4.4",
    "postcss": "^8.5.3",
    "react": "18.2.0",
    "react-d3-tree": "^3.6.5",
    "react-dom": "18.2.0",
    "react-select": "^5.10.0",
    "tailwind-merge": "^3.0.1",
